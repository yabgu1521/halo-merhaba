# Public canonical origin (not a secret)
NEXT_PUBLIC_SITE_URL=
# Reserved for later backend integration; not required by current public pages.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
PAYMENT_WEBHOOK_SECRET=

# Required for this member phase: an exact origin, e.g. http://127.0.0.1:3000
# NEXT_PUBLIC_SITE_URL above must match the browser origin (including port).
# NEXT_PUBLIC_SUPABASE_URL: Supabase API URL.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: publishable/legacy anon key (not a service key).
# SUPABASE_SERVICE_ROLE_KEY: server-only service role key for validated photos and auth rate limits.
# DATABASE_URL: migration tooling only; not used by browser/application requests.
# Optional browser-test executable override:
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Optional, server/tooling-only management API credential for an authorized migration workflow.
# Not used by browser/application code. Never paste or commit its value.
SUPABASE_ACCESS_TOKEN=
# Explicit test-only opt-ins; never production/demo account switches.
RUN_REMOTE_AUTH_TESTS=
RUN_REMOTE_MEMBER_TESTS=
