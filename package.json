{
  "name": "turkindo-connect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "verify:supabase": "node --use-env-proxy scripts/verify-supabase.mjs",
    "test:postgres": "node --import tsx --test --test-concurrency=1 tests/postgres/*.test.ts",
    "test:remote:auth": "node --use-env-proxy --test --test-concurrency=1 tests/remote/auth.test.mjs",
    "test:remote:members": "node --use-env-proxy --test --test-concurrency=1 tests/remote/member.test.mjs",
    "test:candidate-browser": "node --test --test-concurrency=1 tests/browser/candidates.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
